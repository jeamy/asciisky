# Smart Interpolation Configuration
# ==================================
# Environment variables for the smart interpolation system
# Copy this file to .env and adjust values as needed

# Core Feature Flags
# ------------------
# ✅ USED: config/interpolation_config.py:47, api/smart_interpolation.py:45
ENABLE_SMART_INTERPOLATION=false          # Master switch: true=interpolation, false=nearest bucket only

# ✅ USED: config/interpolation_config.py:60, api/smart_interpolation.py:49
INTERPOLATION_STRATEGY=nearest_bucket     # nearest_bucket | smart_interpolation | on_demand_only

# On-Demand Computation
# --------------------
# ✅ USED: config/interpolation_config.py:50
ENABLE_ON_DEMAND_COMPUTATION=true         # Compute missing buckets (SYNC if BACKGROUND_TASKS=false)

# ✅ USED: api/on_demand_computation.py:71
ON_DEMAND_CACHE_TTL=86400                  # Cache TTL for on-demand buckets (seconds, default: 24h)

# ✅ USED: api/on_demand_computation.py:72
ON_DEMAND_MAX_COMPUTATION_TIME=30.0       # Timeout for on-demand computation (seconds)

# ✅ USED: api/on_demand_computation.py:74
ON_DEMAND_MAX_MAGNITUDE_ASTEROIDS=20.0    # Max magnitude for asteroids (default: 20.0)

# ✅ USED: api/on_demand_computation.py:75
ON_DEMAND_MAX_COMETS=100                  # Max comets for on-demand (default: 100, reduced for performance)

# Astronomical Corrections
# ------------------------
# ✅ USED: config/interpolation_config.py:53
ENABLE_ASTRONOMICAL_CORRECTIONS=true      # Apply corrections (atmospheric refraction, etc.)

# ✅ USED: config/interpolation_config.py:63
ASTRONOMICAL_CORRECTION_LEVEL=basic        # none | basic | standard | advanced

# ✅ USED: config/interpolation_config.py:79
INTERPOLATION_MAX_ERROR_DEGREES=2.0        # Max acceptable error for quality validation (degrees)

# Performance Settings
# --------------------
# ✅ USED: config/interpolation_config.py:70
INTERPOLATION_CACHE_TTL=86400              # Cache TTL for interpolated results (seconds, default: 24h)

# ✅ USED: config/interpolation_config.py:73, api/smart_interpolation.py:47
INTERPOLATION_MAX_FUTURE_HOURS=2.0         # Max hours into future to accept bucket (prevents stale data)

# ✅ USED: config/interpolation_config.py:77
INTERPOLATION_MIN_QUALITY_THRESHOLD=0.5   # Min quality for corrections (0.0-1.0, below=skip corrections)

# Retry and Error Handling
# ------------------------
# ✅ USED: config/interpolation_config.py:91
INTERPOLATION_ENABLE_RETRY=true            # Retry failed computations

# ✅ USED: config/interpolation_config.py:94
INTERPOLATION_MAX_RETRIES=2                # Max retry attempts (default: 2)

# ✅ USED: config/interpolation_config.py:97
INTERPOLATION_RETRY_DELAY=1.0              # Delay between retries (seconds)

# Monitoring and Debugging
# ------------------------
# ✅ USED: config/interpolation_config.py:101
INTERPOLATION_ENABLE_METRICS=true          # Collect performance metrics

# ✅ USED: config/interpolation_config.py:104
INTERPOLATION_DEBUG_LOGGING=false          # Enable verbose debug logging

# ✅ USED: config/interpolation_config.py:107
INTERPOLATION_LOG_PERFORMANCE_WARNINGS=true # Log performance warnings

# Gradual Rollout Settings
# ------------------------
# ✅ USED: config/interpolation_config.py:111
INTERPOLATION_ENABLED_USER_IDS=           # Comma-separated user IDs for explicit enable (e.g. "user1,user2")

# ✅ USED: config/interpolation_config.py:114
INTERPOLATION_ENABLED_PERCENTAGE=0.0       # Percentage of users (0-100, 0=disabled, 100=all users)

# Background Tasks
# -----------------
# ✅ USED: config/interpolation_config.py:56, api/smart_interpolation.py:203,225,261
ENABLE_INTERPOLATION_BACKGROUND_TASKS=true # **WICHTIG**: true=ASYNC RabbitMQ Worker, false=SYNC (blockiert!)

# ✅ USED: api/smart_interpolation.py:48
INTERPOLATION_CACHE_COMPUTED=true          # Cache on-demand computed buckets to PostgreSQL

# Advanced Settings [FUTURE - NOT IMPLEMENTED]
# -----------------
# ⚠️  NOT USED: These variables are defined but not implemented in code yet
# INTERPOLATION_BACKGROUND_PRIORITY=5       # [FUTURE] Priority for background tasks (1-10)
# INTERPOLATION_MAX_CONCURRENT_COMPUTATIONS=3 # [FUTURE] Max concurrent on-demand computations
# INTERPOLATION_MEMORY_CACHE_SIZE=100        # [FUTURE] Max items in memory cache
# INTERPOLATION_CLEANUP_INTERVAL=300         # [FUTURE] Cache cleanup interval (seconds)
