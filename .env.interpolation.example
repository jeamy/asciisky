# Smart Interpolation Configuration
# ==================================
# Environment variables for the smart interpolation system
# Copy this file to .env and adjust values as needed

# Core Feature Flags
# ------------------
ENABLE_SMART_INTERPOLATION=false          # Enable/disable smart interpolation system
INTERPOLATION_STRATEGY=nearest_bucket     # Strategy: nearest_bucket, smart_interpolation, on_demand_only, hybrid

# On-Demand Computation
# --------------------
ENABLE_ON_DEMAND_COMPUTATION=true         # Enable on-demand bucket computation
ON_DEMAND_CACHE_TTL=86400                  # Cache TTL for on-demand results (seconds)
ON_DEMAND_MAX_COMPUTATION_TIME=30.0       # Max computation time before timeout (seconds)
ON_DEMAND_MAX_MAGNITUDE_ASTEROIDS=20.0    # Maximum magnitude for asteroid computation
ON_DEMAND_MAX_COMETS=100                  # Maximum number of comets to compute

# Astronomical Corrections
# ------------------------
ENABLE_ASTRONOMICAL_CORRECTIONS=true      # Enable astronomical corrections
ASTRONOMICAL_CORRECTION_LEVEL=basic        # Correction level: none, basic, standard, advanced
INTERPOLATION_MAX_ERROR_DEGREES=2.0        # Max acceptable interpolation error (degrees)

# Performance Settings
# --------------------
INTERPOLATION_CACHE_TTL=86400              # Cache TTL for interpolation results (seconds)
INTERPOLATION_MAX_FUTURE_HOURS=2.0         # Max future hours to accept from cache
INTERPOLATION_MIN_QUALITY_THRESHOLD=0.5   # Minimum quality threshold for corrections

# Retry and Error Handling
# ------------------------
INTERPOLATION_ENABLE_RETRY=true            # Enable retry on computation failure
INTERPOLATION_MAX_RETRIES=2                # Maximum number of retries
INTERPOLATION_RETRY_DELAY=1.0              # Delay between retries (seconds)

# Monitoring and Debugging
# ------------------------
INTERPOLATION_ENABLE_METRICS=true          # Enable performance metrics collection
INTERPOLATION_DEBUG_LOGGING=false          # Enable debug logging
INTERPOLATION_LOG_PERFORMANCE_WARNINGS=true # Log performance warnings

# Gradual Rollout Settings
# ------------------------
INTERPOLATION_ENABLED_USER_IDS=           # Comma-separated list of enabled user IDs
INTERPOLATION_ENABLED_PERCENTAGE=0.0       # Percentage of users to enable (0-100)

# Background Tasks
# -----------------
ENABLE_INTERPOLATION_BACKGROUND_TASKS=true # Enable background task triggering
INTERPOLATION_CACHE_COMPUTED=true          # Cache on-demand computed results

# Advanced Settings
# -----------------
# These settings are for fine-tuning and should be changed with care
INTERPOLATION_BACKGROUND_PRIORITY=5       # Priority for background tasks (1-10)
INTERPOLATION_MAX_CONCURRENT_COMPUTATIONS=3 # Max concurrent on-demand computations
INTERPOLATION_MEMORY_CACHE_SIZE=100        # Max items in memory cache
INTERPOLATION_CLEANUP_INTERVAL=300         # Cache cleanup interval (seconds)
