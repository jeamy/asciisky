# Worker Server C Configuration
# ==============================
# Copy this to .env.c and adjust for Server C (4 cores)
# IMPORTANT: Passwords MUST match main .env!

# ===== Multi-Host Configuration ===== [SCRIPT]
RABBITMQ_MAIN=asciisky.example.org
RABBITMQ_B=rabbit-b.example.org
RABBITMQ_C=rabbit-c.example.org
RABBITMQ_MAIN_IP=203.0.113.10

# ===== PostgreSQL ===== [CODE] [SCRIPT]
# MUST match main .env!
POSTGRES_HOST=${RABBITMQ_MAIN}
POSTGRES_PORT=5432
POSTGRES_DB=asciisky
POSTGRES_USER=asciisky
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ===== RabbitMQ ===== [CODE] [SCRIPT]
# MUST match main .env!
RABBITMQ_HOST=${RABBITMQ_MAIN}
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
RABBITMQ_HEARTBEAT=60
RABBITMQ_PREFETCH_COUNT=2
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:${RABBITMQ_PORT}/

# RabbitMQ Feature Flags [CODE]
USE_RABBITMQ=true
USE_RABBITMQ_ASTEROIDS=true
USE_RABBITMQ_COMETS=true
RABBITMQ_TIMEOUT=30
FALLBACK_TO_OLD_ON_ERROR=true

# ===== Session Secret ===== [CODE] [SCRIPT]
# Not used on worker-only hosts, but keep for consistency
SESSION_SECRET=CHANGE_ME_RANDOM_HEX_STRING_HERE

# ===== Worker Scaling - SERVER C SPECIFIC ===== [SCRIPT] [DOCKER]
# Server C: 4 CPU Cores → 4 Unified Workers (1 per core)
UNIFIED_WORKERS=4
WORKER_MONITOR=1

# ===== Worker Configuration ===== [CODE] [DOCKER]
WORKER_LOG_LEVEL=INFO
WORKER_TYPE=unified                     # unified (handles all task types)
WORKER_MEMORY_LIMIT_MB=384
WORKER_CPU_LIMIT_PERCENT=70

# ===== Monitoring ===== [DOCKER]
MONITOR_PORT=8081

# ===== Precompute Settings ===== [CODE]
ASCII_SKY_PRECOMPUTE_HOURS=720
ASCII_SKY_RETENTION_DAYS=30
PRECOMPUTE_COORDINATOR_INTERVAL=3600
PRECOMPUTE_COORDINATOR_RETRY_INTERVAL=30

# ===== Magnitude Limits ===== [CODE]
ASCII_SKY_ASTEROID_MAX_ABSOLUTE_MAG=14.0
ASCII_SKY_ASTEROID_MAX_APPARENT_MAG=10.0
ASCII_SKY_COMET_MAX_ABSOLUTE_MAG=20.0
ASCII_SKY_COMET_MAX_APPARENT_MAG=14.0

# ===== Event Computation Limits ===== [CODE]
ASCII_SKY_ASTEROIDS_EVENTS_MAX=50
ASCII_SKY_COMET_EVENTS_MAX=50

# ===== Smart Interpolation ===== [CODE]
ENABLE_SMART_INTERPOLATION=true
INTERPOLATION_STRATEGY=smart_interpolation
ENABLE_ON_DEMAND_COMPUTATION=true
INTERPOLATION_ENABLED_PERCENTAGE=100.0
ENABLE_INTERPOLATION_BACKGROUND_TASKS=true
INTERPOLATION_CACHE_COMPUTED=true
