# Worker Server C Configuration
# Copy this to .env.c and adjust worker counts for Server C
# IMPORTANT: Passwords MUST match main .env!

# ===== Main Server Hostname =====
RABBITMQ_MAIN=asciisky.example.org

# ===== REQUIRED: Same as main .env =====
POSTGRES_PASSWORD=changeme
RABBITMQ_PASSWORD=changeme

# PostgreSQL connection (main server)
POSTGRES_HOST=${RABBITMQ_MAIN}
POSTGRES_PORT=5432
POSTGRES_DB=asciisky
POSTGRES_USER=asciisky

# RabbitMQ connection (main server)
RABBITMQ_HOST=${RABBITMQ_MAIN}
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_HEARTBEAT=60
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:${RABBITMQ_PORT}/

# ===== Worker Server C specific =====
# Adjust these based on Server C hardware
# UNIFIED_WORKERS können ALLE Tasks übernehmen (Precompute + Asteroids + Comets)
# Empfehlung: 1-2 Worker pro CPU-Kern
UNIFIED_WORKERS=4
WORKER_MONITOR=1

# Worker settings
RABBITMQ_PREFETCH_COUNT=1

# Precompute settings (same as main)
ASCII_SKY_PRECOMPUTE_HOURS=720
ASCII_SKY_RETENTION_DAYS=30
