# Test Environment - Lokale Umgebung auf einem Rechner
# Verwendung: docker compose --env-file .env.test up -d

# PostgreSQL
POSTGRES_DB=asciisky_test
POSTGRES_USER=asciisky
POSTGRES_PASSWORD=test123

# RabbitMQ
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=test123

# Worker Skalierung (reduziert für lokales Testing)
PRECOMPUTE_WORKERS=2
ASTEROID_WORKERS=1
COMET_WORKERS=1

# Magnitude Limits (für schnelleres Testing)
ASCII_SKY_ASTEROID_MAX_ABSOLUTE_MAG=14.0
ASCII_SKY_ASTEROID_MAX_APPARENT_MAG=20.0
ASCII_SKY_COMET_MAX_ABSOLUTE_MAG=18.0
ASCII_SKY_COMET_MAX_APPARENT_MAG=20.0

# Event Limits (reduziert)
ASCII_SKY_ASTEROIDS_EVENTS_MAX=30
ASCII_SKY_COMET_EVENTS_MAX=20

# Worker Log Level
WORKER_LOG_LEVEL=INFO

# Precompute (nur 24h statt 720h)
ASCII_SKY_PRECOMPUTE_HOURS=24

# RabbitMQ Settings
RABBITMQ_HEARTBEAT=60
RABBITMQ_PREFETCH_COUNT=1

# Hybrid Deduplication (Phase 3)
ENABLE_HYBRID_DEDUPLICATION=true
ASCII_SKY_DEDUPLICATION_TTL=300
ASCII_SKY_ADVISORY_LOCK_TTL=300
