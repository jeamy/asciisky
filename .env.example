# ASCII Sky Production Environment Configuration
# =================================================
# Kopiere diese Datei zu .env und passe die Werte an
#
# Legende:
#   [CODE]   - Wird im Python-Code verwendet
#   [SCRIPT] - Wird in Shell-Scripts verwendet
#   [DOCKER] - Wird nur in docker-compose.yml verwendet
#   [FUTURE] - Noch nicht implementiert

# ===== Multi-Host Configuration ===== [SCRIPT]
# Hostnames für verteiltes Setup (verwendet in setup-production.sh, setup-firewall.sh)
RABBITMQ_MAIN=asciisky.example.org      # Hauptserver mit API + PostgreSQL + RabbitMQ
RABBITMQ_B=rabbit-b.example.org         # Worker Host B (8 Cores)
RABBITMQ_C=rabbit-c.example.org         # Worker Host C (4 Cores)

# Main server IP for extra_hosts (example IP, replace with your main server's static IP)
RABBITMQ_MAIN_IP=203.0.113.10

# ===== PostgreSQL ===== [CODE] [SCRIPT]
# Verwendet in: db_utils.py, allen Workern, setup-production.sh
POSTGRES_HOST=${RABBITMQ_MAIN}
POSTGRES_PORT=5432
POSTGRES_DB=asciisky
POSTGRES_USER=asciisky
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE  # MUSS gesetzt sein!

# ===== RabbitMQ ===== [CODE] [SCRIPT]
# Verwendet in: allen Workern, API routes, setup-production.sh
RABBITMQ_HOST=${RABBITMQ_MAIN}
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE  # MUSS gesetzt sein!
# ✅ USED: precompute_coordinator.py:47
RABBITMQ_HEARTBEAT=60                    # RabbitMQ Connection Heartbeat (Sekunden, 0=disabled)
RABBITMQ_PREFETCH_COUNT=2                # [CODE] Worker QoS (optimiert für bessere Auslastung)
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:${RABBITMQ_PORT}/

# RabbitMQ Feature Flags [CODE]
USE_RABBITMQ=true                        # api/routes/*.py
USE_RABBITMQ_ASTEROIDS=true              # api/routes/asteroids.py
USE_RABBITMQ_COMETS=true                 # api/routes/comets.py
RABBITMQ_TIMEOUT=30                      # api/routes/*.py
FALLBACK_TO_OLD_ON_ERROR=true            # api/routes/*.py

# ===== Session Secret ===== [CODE] [SCRIPT]
# Verwendet in: main.py, setup-production.sh
# Generiere mit: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_RANDOM_HEX_STRING_HERE  # MUSS gesetzt sein!

# ===== Worker Scaling ===== [SCRIPT] [DOCKER]
# Verwendet in: setup-production.sh, docker-compose*.yml
# Diese Werte gelten für den aktuellen Host (Main, B, C)

# Worker Hosts B/C - für docker-compose.workers.yml
# UNIFIED_WORKERS können ALLE Tasks übernehmen (Precompute + Asteroids + Comets)
# Empfehlung: 1-2 Worker pro CPU-Kern
# - Server B (8 Cores): UNIFIED_WORKERS=8 (siehe .env.b.example)
# - Server C (4 Cores): UNIFIED_WORKERS=4 (siehe .env.c.example)
UNIFIED_WORKERS=8                        # Neue Unified Architektur
WORKER_MONITOR=1                         # Monitoring Dashboard pro Host

# ===== Worker Configuration ===== [CODE] [DOCKER]
# ✅ USED: workers/start_unified_worker.py:56
WORKER_LOG_LEVEL=INFO                   # Worker Logging Level (DEBUG|INFO|WARNING|ERROR)

# [DOCKER] Nur in docker-compose.yml verwendet (nicht im Code!)
WORKER_TYPE=unified                     # unified (handles all task types)
WORKER_MEMORY_LIMIT_MB=384              # Memory Limit pro Worker
WORKER_CPU_LIMIT_PERCENT=70             # CPU Limit pro Worker

# [FUTURE] Noch nicht implementiert
# ENABLE_SHARED_RESOURCES=true
# SHARED_RESOURCES_CACHE_TTL=3600
# WORKER_ENABLE_PERFORMANCE_METRICS=true
# WORKER_HEALTH_CHECK_INTERVAL=30
# WORKER_AUTO_RESTART_ON_FAILURE=true
# PRECOMPUTE_QUEUE_TYPE=classic
# ON_DEMAND_QUEUE_TYPE=quorum
# WORKER_MAX_RETRY_ATTEMPTS=3
# WORKER_RETRY_DELAY_BASE=5
# ON_DEMAND_WORKER_POOL_SIZE=3
# ON_DEMAND_BATCH_SIZE=5
# ON_DEMAND_TIMEOUT_SECONDS=45

# ===== Monitoring ===== [DOCKER]
MONITOR_PORT=8080                       # Worker Monitor Port
# Worker B: 8080, Worker C: 8081 (via .env.b, .env.c)

# ===== Precompute Coordinator Settings ===== [CODE]
# Verwendet in: precompute_coordinator.py
# ✅ USED: precompute_coordinator.py:358
ASCII_SKY_PRECOMPUTE_HOURS=720           # Stunden voraus berechnen (720=30 Tage)

# ⚠️  NOT USED: [FUTURE] Noch nicht implementiert
# ASCII_SKY_RETENTION_DAYS=30              # [FUTURE] Auto-delete old buckets

# ✅ USED: precompute_coordinator.py:359
PRECOMPUTE_COORDINATOR_INTERVAL=3600     # Coordinator Interval (Sekunden, 3600=1h)

# ✅ USED: precompute_coordinator.py:360
PRECOMPUTE_COORDINATOR_RETRY_INTERVAL=30 # Retry Interval bei Fehler (Sekunden)

# ===== Magnitude Limits ===== [CODE]
# Verwendet in: bright_asteroids.py, comets.py, settings.py
# ✅ USED: bright_asteroids.py:34
ASCII_SKY_ASTEROID_MAX_ABSOLUTE_MAG=14.0 # H-Magnitude Prefilter (kleiner=heller)

# ✅ USED: bright_asteroids.py:36, settings.py:23
ASCII_SKY_ASTEROID_MAX_APPARENT_MAG=10.0 # V-Magnitude Final Filter (sichtbar am Himmel)

# ✅ USED: comets.py:57
ASCII_SKY_COMET_MAX_ABSOLUTE_MAG=20.0    # H-Magnitude Prefilter für Kometen

# ✅ USED: comets.py:56, settings.py:24
ASCII_SKY_COMET_MAX_APPARENT_MAG=14.0    # V-Magnitude Final Filter für Kometen

# ===== Event Computation Limits ===== [CODE]
# Verwendet in: bright_asteroids.py, comets.py
# ✅ USED: bright_asteroids.py (via workers)
ASCII_SKY_ASTEROIDS_EVENTS_MAX=50        # Max Rise/Set/Transit Events pro Asteroid

# ✅ USED: comets.py:59
ASCII_SKY_COMET_EVENTS_MAX=50            # Max Rise/Set/Transit Events pro Komet

# ===== Smart Interpolation ===== [CODE]
# Verwendet in: config/interpolation_config.py, api/smart_interpolation.py
# Siehe .env.interpolation.example für alle Optionen
ENABLE_SMART_INTERPOLATION=true          # Smart Interpolation aktivieren
INTERPOLATION_STRATEGY=smart_interpolation # nearest_bucket, smart_interpolation, on_demand_only
ENABLE_ON_DEMAND_COMPUTATION=true        # On-Demand Berechnung aktivieren

# Gradual Rollout
INTERPOLATION_ENABLED_PERCENTAGE=100.0   # 0-100% der Benutzer

# ===== HINWEIS =====
# Für detaillierte Interpolation-Konfiguration siehe:
#   .env.interpolation.example
# Alle INTERPOLATION_* und ON_DEMAND_* Variablen werden im Code verwendet!
