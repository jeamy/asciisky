# ASCII Sky Production Environment Configuration
# Kopiere diese Datei zu .env und passe die Werte an

# ===== Server Hostnames =====
# Main server hostname (replace with your domain)
RABBITMQ_MAIN=asciisky.example.org
RABBITMQ_B=rabbit-b.example.org
RABBITMQ_C=rabbit-c.example.org

# Main server IP for extra_hosts (example IP, replace with your main server's static IP)
RABBITMQ_MAIN_IP=203.0.113.10

# ===== PostgreSQL =====
POSTGRES_HOST=${RABBITMQ_MAIN}
POSTGRES_PORT=5432
POSTGRES_DB=asciisky
POSTGRES_USER=asciisky
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ===== RabbitMQ =====
RABBITMQ_HOST=${RABBITMQ_MAIN}
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
RABBITMQ_HEARTBEAT=60
RABBITMQ_PREFETCH_COUNT=1
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:${RABBITMQ_PORT}/

# RabbitMQ Feature Flags (für asynchrone API-Requests)
USE_RABBITMQ=true
USE_RABBITMQ_ASTEROIDS=true
USE_RABBITMQ_COMETS=true
RABBITMQ_TIMEOUT=30
FALLBACK_TO_OLD_ON_ERROR=true

# ===== Session Secret =====
# Generiere mit: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_RANDOM_HEX_STRING_HERE

# ===== Worker Scaling (Multi-Host Setup) =====
# Diese Werte gelten für den aktuellen Host (Main, B, C)

# Main Server (localhost) - für docker-compose.production.yml
PRECOMPUTE_WORKERS=4

# Worker Hosts B/C (Unified Architecture) - für docker-compose.workers.yml
# UNIFIED_WORKERS können ALLE Tasks übernehmen (Precompute + Asteroids + Comets)
# Empfehlung: 1-2 Worker pro CPU-Kern
# - Server B (8 Cores): UNIFIED_WORKERS=8 (siehe .env.b.example)
# - Server C (4 Cores): UNIFIED_WORKERS=4 (siehe .env.c.example)
UNIFIED_WORKERS=8
WORKER_MONITOR=1          # Monitoring Dashboard pro Host

# ===== Worker Optimierung =====
# Optimiertes Worker Setup mit Unified Architecture
WORKER_TYPE=unified                     # unified, precompute, on_demand
WORKER_LOG_LEVEL=INFO                   # DEBUG, INFO, WARNING, ERROR
RABBITMQ_PREFETCH_COUNT=2               # Optimiert für bessere Auslastung
WORKER_MEMORY_LIMIT_MB=384              # Memory Limit pro Worker
WORKER_CPU_LIMIT_PERCENT=70             # CPU Limit pro Worker

# Shared Resources (Memory-Effizienz)
ENABLE_SHARED_RESOURCES=true            # Shared Skyfield Resources
SHARED_RESOURCES_CACHE_TTL=3600         # 1 Stunde Cache

# Performance Monitoring
WORKER_ENABLE_PERFORMANCE_METRICS=true  # Detaillierte Metriken
WORKER_HEALTH_CHECK_INTERVAL=30         # Health Check alle 30s
WORKER_AUTO_RESTART_ON_FAILURE=true     # Auto-Restart bei Fehlern

# Queue Optimierung
PRECOMPUTE_QUEUE_TYPE=classic           # Classic für hohen Durchsatz
ON_DEMAND_QUEUE_TYPE=quorum             # Quorum für Zuverlässigkeit
WORKER_MAX_RETRY_ATTEMPTS=3             # Maximale Retry-Versuche
WORKER_RETRY_DELAY_BASE=5               # Basis Retry-Delay

# Smart Interpolation Worker Integration
ENABLE_ON_DEMAND_COMPUTATION=true       # On-Demand für Smart Interpolation
ON_DEMAND_WORKER_POOL_SIZE=3            # Parallele On-Demand Worker
ON_DEMAND_BATCH_SIZE=5                  # Batch-Processing
ON_DEMAND_TIMEOUT_SECONDS=45            # Timeout für On-Demand Tasks

# ===== Multi-Host Configuration =====
# Hostnames für verteiltes Setup
RABBITMQ_MAIN=asciisky.example.org      # Hauptserver
RABBITMQ_B=rabbit-b.example.org         # Worker Host B
RABBITMQ_C=rabbit-c.example.org         # Worker Host C

# Worker Host Aktivierung
SETUP_WORKER_B=true                     # Worker Host B aktivieren
SETUP_WORKER_C=true                     # Worker Host C aktivieren

# Monitoring Ports (pro Host unterschiedlich)
MONITOR_PORT=8080                       # Worker Monitor Port
# Worker B: 8080, Worker C: 8081 (via .env.b, .env.c)

# ===== Precompute Settings =====
ASCII_SKY_PRECOMPUTE_HOURS=720
ASCII_SKY_RETENTION_DAYS=30
PRECOMPUTE_COORDINATOR_INTERVAL=3600
PRECOMPUTE_COORDINATOR_RETRY_INTERVAL=30

# ===== Magnitude Limits =====
ASCII_SKY_ASTEROID_MAX_ABSOLUTE_MAG=14.0
ASCII_SKY_ASTEROID_MAX_APPARENT_MAG=10.0
ASCII_SKY_COMET_MAX_ABSOLUTE_MAG=20.0
ASCII_SKY_COMET_MAX_APPARENT_MAG=14.0

# ===== Event Computation Limits =====
# Begrenzt CPU-Last durch Limitierung von Rise/Set/Transit Berechnungen
ASCII_SKY_ASTEROIDS_EVENTS_MAX=50
ASCII_SKY_COMET_EVENTS_MAX=50

# Aktivierung Smart Interpolation
# see .env.interpolation.example for details
ENABLE_SMART_INTERPOLATION=true
INTERPOLATION_STRATEGY=smart_interpolation

# Gradual Rollout
INTERPOLATION_ENABLED_PERCENTAGE=100.0

# ===== Worker Optimierung =====
# Optimiertes Worker Setup mit Unified Architecture
WORKER_TYPE=unified                     # unified, precompute, on_demand
WORKER_LOG_LEVEL=INFO                   # DEBUG, INFO, WARNING, ERROR
RABBITMQ_PREFETCH_COUNT=2               # Optimiert für bessere Auslastung
WORKER_MEMORY_LIMIT_MB=384              # Memory Limit pro Worker
WORKER_CPU_LIMIT_PERCENT=70             # CPU Limit pro Worker

# Shared Resources (Memory-Effizienz)
ENABLE_SHARED_RESOURCES=true            # Shared Skyfield Resources
SHARED_RESOURCES_CACHE_TTL=3600         # 1 Stunde Cache

# Performance Monitoring
WORKER_ENABLE_PERFORMANCE_METRICS=true  # Detaillierte Metriken
WORKER_HEALTH_CHECK_INTERVAL=30         # Health Check alle 30s
WORKER_AUTO_RESTART_ON_FAILURE=true     # Auto-Restart bei Fehlern

# Queue Optimierung
PRECOMPUTE_QUEUE_TYPE=classic           # Classic für hohen Durchsatz
ON_DEMAND_QUEUE_TYPE=quorum             # Quorum für Zuverlässigkeit
WORKER_MAX_RETRY_ATTEMPTS=3             # Maximale Retry-Versuche
WORKER_RETRY_DELAY_BASE=5               # Basis Retry-Delay

# Smart Interpolation Worker Integration
ENABLE_ON_DEMAND_COMPUTATION=true       # On-Demand für Smart Interpolation
ON_DEMAND_WORKER_POOL_SIZE=3            # Parallele On-Demand Worker
ON_DEMAND_BATCH_SIZE=5                  # Batch-Processing
ON_DEMAND_TIMEOUT_SECONDS=45            # Timeout für On-Demand Tasks
