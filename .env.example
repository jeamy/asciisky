# ASCII Sky Production Environment Configuration
# Kopiere diese Datei zu .env und passe die Werte an

# ===== Server Hostnames =====
# Main server hostname (replace with your domain)
RABBITMQ_MAIN=asciisky.example.org
RABBITMQ_B=rabbit-b.example.org
RABBITMQ_C=rabbit-c.example.org

# Main server IP for extra_hosts (example IP, replace with your main server's static IP)
RABBITMQ_MAIN_IP=203.0.113.10

# ===== PostgreSQL =====
POSTGRES_HOST=${RABBITMQ_MAIN}
POSTGRES_PORT=5432
POSTGRES_DB=asciisky
POSTGRES_USER=asciisky
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ===== RabbitMQ =====
RABBITMQ_HOST=${RABBITMQ_MAIN}
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
RABBITMQ_HEARTBEAT=60
RABBITMQ_PREFETCH_COUNT=1
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:${RABBITMQ_PORT}/

# RabbitMQ Feature Flags (für asynchrone API-Requests)
USE_RABBITMQ=true
USE_RABBITMQ_ASTEROIDS=true
USE_RABBITMQ_COMETS=true
RABBITMQ_TIMEOUT=30
FALLBACK_TO_OLD_ON_ERROR=true

# ===== Session Secret =====
# Generiere mit: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_RANDOM_HEX_STRING_HERE

# ===== Worker Setup =====
# Setze auf 'true' um Worker-Server automatisch zu deployen
SETUP_WORKER_B=true
SETUP_WORKER_C=true

# ===== Worker Scaling (Anzahl paralleler Worker) =====
# Diese Werte gelten für den aktuellen Host
# Hauptserver: Nur Precompute-Worker
# Worker-Hosts B/C: Precompute + Asteroid + Comet Worker
PRECOMPUTE_WORKERS=4
ASTEROID_WORKERS=2
COMET_WORKERS=2

# Hinweis: Jeder Host (main, B, C) hat seine eigene .env Datei
# Die Worker-Anzahl wird pro Host individuell konfiguriert

# ===== Precompute Settings =====
ASCII_SKY_PRECOMPUTE_HOURS=720
ASCII_SKY_RETENTION_DAYS=30
PRECOMPUTE_COORDINATOR_INTERVAL=3600
PRECOMPUTE_COORDINATOR_RETRY_INTERVAL=30

# ===== Magnitude Limits =====
ASCII_SKY_ASTEROID_MAX_ABSOLUTE_MAG=14.0
ASCII_SKY_ASTEROID_MAX_APPARENT_MAG=10.0
ASCII_SKY_COMET_MAX_ABSOLUTE_MAG=20.0
ASCII_SKY_COMET_MAX_APPARENT_MAG=14.0

# ===== Event Computation Limits =====
# Begrenzt CPU-Last durch Limitierung von Rise/Set/Transit Berechnungen
ASCII_SKY_ASTEROIDS_EVENTS_MAX=50
ASCII_SKY_COMET_EVENTS_MAX=50
